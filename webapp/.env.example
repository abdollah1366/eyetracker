# PostgreSQL
POSTGRES_USER=eye_tracker
POSTGRES_PASSWORD=change_me
POSTGRES_DB=eye_tracker
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# Host port for the built frontend (nginx). Open http://localhost:8080
FRONTEND_HOST_PORT=8080

# SQLAlchemy URL (docker compose supplies this automatically; override locally if needed)
DATABASE_URL=postgresql+psycopg://eye_tracker:change_me@postgres:5432/eye_tracker

# Security — replace JWT_SECRET with a long random value in every real deployment
JWT_SECRET=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed administrator (created only when the users table is empty of that email)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Browser origins allowed by CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Quality Gate thresholds (also adjustable at runtime via /api/v1/config/quality)
MIN_VALID_GAZE_RATIO=0.70
MAX_TRACKING_GAP_SEC=0.75
BRIGHTNESS_MIN=25
BRIGHTNESS_MAX=235
MAX_CALIBRATION_ERROR_PX=180

# Acquisition protocol: the thesis targets 10 stimuli of 10 seconds each; no stimulus is duplicated.
STIMULUS_TARGET=10
STIMULUS_DURATION_SEC=10

APP_VERSION=1.0.0
